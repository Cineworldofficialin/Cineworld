<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/userPanelScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101018"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/userPanelBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="#FFFFC107"
                android:textSize="38sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="USER DASHBOARD"
                android:textColor="#FFFFC107"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="✦"
                android:textColor="#FFFFC107"
                android:textSize="25sp" />
        </LinearLayout>

        <!-- WELCOME -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="WELCOME BACK"
            android:textColor="#FFAAAAAA"
            android:textSize="12sp"
            android:letterSpacing="0.12" />

        <!-- PROFILE CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#FF191920"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="#FF292018"
                android:gravity="center"
                android:text="👤"
                android:textSize="48sp" />

            <TextView
                android:id="@+id/userPanelName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="CineWorld User"
                android:textColor="#FFFFFFFF"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/userPanelEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:text="Welcome to CineWorld"
                android:textColor="#FFAAAAAA"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/userPanelMemberId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#FF302817"
                android:paddingLeft="16dp"
                android:paddingTop="8dp"
                android:paddingRight="16dp"
                android:paddingBottom="8dp"
                android:text="CINEWORLD MEMBER"
                android:textColor="#FFFFC107"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/userPanelEdit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="18dp"
                android:backgroundTint="#FFFFC107"
                android:text="EDIT PROFILE"
                android:textColor="#FF191920"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- YOUR CINEWORLD -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="YOUR CINEWORLD"
            android:textColor="#FFFFC107"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_marginEnd="7dp"
                android:layout_weight="1"
                android:background="#FF191920"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="♡"
                    android:textColor="#FFFFC107"
                    android:textSize="25sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WATCHLIST"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:background="#FF191920"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="◷"
                    android:textColor="#FFFFC107"
                    android:textSize="25sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HISTORY"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- ACCOUNT MENU -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="ACCOUNT MENU"
            android:textColor="#FFFFC107"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/userPanelWatchlist"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#FF25232A"
            android:gravity="center_vertical"
            android:text="♡     My Watchlist     ›"
            android:textColor="#FFFFFFFF" />

        <Button
            android:id="@+id/userPanelHistory"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#FF25232A"
            android:gravity="center_vertical"
            android:text="◷     Watch History     ›"
            android:textColor="#FFFFFFFF" />

        <Button
            android:id="@+id/userPanelDownloads"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#FF25232A"
            android:gravity="center_vertical"
            android:text="↓     My Downloads     ›"
            android:textColor="#FFFFFFFF" />

        <Button
            android:id="@+id/userPanelSettings"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#FF25232A"
            android:gravity="center_vertical"
            android:text="⚙     App Settings     ›"
            android:textColor="#FFFFFFFF" />

        <Button
            android:id="@+id/userPanelHelp"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#FF25232A"
            android:gravity="center_vertical"
            android:text="@string/user_panel_help"
            android:textColor="#FFFFFFFF" />

        <Button
            android:id="@+id/userPanelPrivacy"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#FF25232A"
            android:gravity="center_vertical"
            android:text="♧     Privacy Policy     ›"
            android:textColor="#FFFFFFFF" />

        <!-- LOGIN -->
        <Button
            android:id="@+id/userPanelLogin"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="22dp"
            android:backgroundTint="#FFFFC107"
            android:text="LOGIN / CREATE ACCOUNT"
            android:textColor="#FF191920"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- LOGOUT -->
        <Button
            android:id="@+id/userPanelLogout"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="22dp"
            android:backgroundTint="#FFFFC107"
            android:text="LOGOUT"
            android:textColor="#FF191920"
            android:textStyle="bold" />

        <!-- FOOTER -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:padding="12dp"
            android:text="CINEWORLD  •  YOUR MOVIES. YOUR WORLD."
            android:textColor="#FF777777"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
