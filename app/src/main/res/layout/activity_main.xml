<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#101018">

    <!-- TOP HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="10dp"
        android:background="#101018">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CINEWORLD"
                android:textColor="#FFFFC107"
                android:textSize="27sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Movies. Your World."
                android:textColor="#FFBBBBBB"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- SEARCH -->
        <TextView
            android:id="@+id/searchButton"
            android:layout_width="48dp"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="⌕"
            android:textColor="#FFFFFFFF"
            android:textSize="32sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Search" />

        <!-- NOTIFICATION -->
        <TextView
            android:id="@+id/notificationButton"
            android:layout_width="48dp"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="♧"
            android:textColor="#FFFFFFFF"
            android:textSize="25sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Notifications" />

        <!-- PROFILE HEADER BUTTON -->
        <TextView
            android:id="@+id/profileButton"
            android:layout_width="48dp"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="◎"
            android:textColor="#FFFFFFFF"
            android:textSize="27sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Profile" />
    </LinearLayout>

    <!-- MAIN CONTENT -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/mainScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="18dp">

                <!-- HOME CONTENT -->
                <LinearLayout
                    android:id="@+id/homeContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <!-- FEATURED BANNER -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="245dp"
                        android:layout_marginTop="8dp">

                        <ImageView
                            android:id="@+id/featuredImage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:background="#FF292936"
                            android:contentDescription="Featured movie" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|end"
                            android:layout_margin="12dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:text="m.dailyhunt"
                            android:textColor="#FFFFFFFF"
                            android:textSize="10sp"
                            android:background="#99000000" />
                    </FrameLayout>

                    <!-- FEATURED DETAILS -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="#FF20202B">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="● FEATURED"
                            android:textColor="#FF42D68A"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/featuredTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Featured Movies"
                            android:textColor="#FFFFFFFF"
                            android:textSize="23sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Discover amazing movies and enjoy your favourite entertainment."
                            android:textColor="#FFBBBBBB"
                            android:textSize="13sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/featuredPlayButton"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:text="▶ PLAY NOW"
                                android:textColor="#FF101018"
                                android:textStyle="bold"
                                android:backgroundTint="#FFFFC107" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:layout_marginStart="10dp"
                                android:gravity="center"
                                android:text="MORE INFO"
                                android:textColor="#FFFFC107"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:background="#FF30303A" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- TRENDING HEADING -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Trending Now"
                            android:textColor="#FFFFFFFF"
                            android:textSize="21sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/seeAllTrending"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:gravity="center"
                            android:paddingStart="12dp"
                            android:paddingEnd="4dp"
                            android:text="See All  ›"
                            android:textColor="#FFFFC107"
                            android:textSize="14sp"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>

                    <!-- TRENDING POSTERS -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp"
                        android:weightSum="3">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingEnd="5dp">

                            <ImageView
                                android:id="@+id/posterOne"
                                android:layout_width="match_parent"
                                android:layout_height="155dp"
                                android:scaleType="centerCrop"
                                android:background="#FF292936"
                                android:contentDescription="Action movie" />

                            <TextView
                                android:id="@+id/movieOne"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="7dp"
                                android:text="Action"
                                android:textColor="#FFFFFFFF"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:gravity="center" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="3dp"
                            android:paddingEnd="3dp">

                            <ImageView
                                android:id="@+id/posterTwo"
                                android:layout_width="match_parent"
                                android:layout_height="155dp"
                                android:scaleType="centerCrop"
                                android:background="#FF292936"
                                android:contentDescription="Romance movie" />

                            <TextView
                                android:id="@+id/movieTwo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="7dp"
                                android:text="Romance"
                                android:textColor="#FFFFFFFF"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:gravity="center" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="5dp">

                            <ImageView
                                android:id="@+id/posterThree"
                                android:layout_width="match_parent"
                                android:layout_height="155dp"
                                android:scaleType="centerCrop"
                                android:background="#FF292936"
                                android:contentDescription="Thriller movie" />

                            <TextView
                                android:id="@+id/movieThree"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="7dp"
                                android:text="Thriller"
                                android:textColor="#FFFFFFFF"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:gravity="center" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- MOVIES CONTENT -->
                <LinearLayout
                    android:id="@+id/moviesContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone" />

                <!-- SHOWS CONTENT (kept for Java compatibility, bottom tab hidden) -->
                <LinearLayout
                    android:id="@+id/showsContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone" />

                <!-- DOWNLOADS CONTENT -->
                <LinearLayout
                    android:id="@+id/downloadsContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone" />

                <!-- PROFILE CONTENT (kept for header/profile Java references) -->
                <LinearLayout
                    android:id="@+id/profileContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone" />

            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- GLASS BOTTOM NAVIGATION: HOME, MOVIES, DOWNLOADS -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#101018"
        android:elevation="16dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:gravity="center"
            android:background="@drawable/bg_nav_active"
            android:text="⌂&#10;Home"
            android:textColor="#FFFFC107"
            android:textSize="14sp"
            android:textStyle="bold"
            android:lineSpacingExtra="3dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Home" />

        <TextView
            android:id="@+id/navMovies"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:gravity="center"
            android:background="@drawable/bg_nav_glass"
            android:text="▣&#10;Movies"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Movies" />

        <TextView
            android:id="@+id/navShows"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▤&#10;Shows"
            android:textColor="#FFAAAAAA"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/navDownloads"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:gravity="center"
            android:background="@drawable/bg_nav_glass"
            android:text="↓&#10;Downloads"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Downloads" />

        <TextView
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="♙&#10;Profile"
            android:textColor="#FFAAAAAA"
            android:textSize="12sp"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
