<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101018"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/backButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="#FFC107"
                android:textSize="34sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="EDIT PROFILE"
                android:textColor="#FFC107"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="42dp"
                android:layout_height="wrap_content"
                android:text="✦"
                android:textColor="#FFC107"
                android:textSize="23sp"
                android:gravity="center" />
        </LinearLayout>

        <!-- PROFILE COMPLETION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:background="#191920"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PROFILE COMPLETION"
                android:textColor="#FFC107"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/profilePercentage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="85% Complete"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/profileProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="12dp"
                android:progress="85"
                android:progressTint="#FFC107"
                android:progressBackgroundTint="#333333" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Complete your profile to enjoy a better CineWorld experience."
                android:textColor="#AAAAAA"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- PROFILE PHOTO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="#191920"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:id="@+id/profileImage"
                android:layout_width="105dp"
                android:layout_height="105dp"
                android:background="#292929"
                android:src="@android:drawable/ic_menu_myplaces"
                android:scaleType="centerCrop"
                android:contentDescription="Profile photo" />

            <TextView
                android:id="@+id/changePhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="✎  CHANGE PHOTO"
                android:textColor="#FFC107"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/removePhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="REMOVE PHOTO"
                android:textColor="#AAAAAA"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/memberBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:background="#332B1600"
                android:padding="9dp"
                android:text="✦  CINEWORLD MEMBER"
                android:textColor="#FFC107"
                android:textStyle="bold"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/memberId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="MEMBER ID: CW-2026-001"
                android:textColor="#AAAAAA"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- PERSONAL INFORMATION -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="PERSONAL INFORMATION"
            android:textColor="#FFC107"
            android:textStyle="bold"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/editName"
            style="@style/ProfileEditField"
            android:hint="Full Name"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/editEmail"
            style="@style/ProfileEditField"
            android:hint="Email Address"
            android:inputType="textEmailAddress" />

        <EditText
            android:id="@+id/editPhone"
            style="@style/ProfileEditField"
            android:hint="Phone Number"
            android:inputType="phone" />

        <EditText
            android:id="@+id/editDob"
            style="@style/ProfileEditField"
            android:hint="Date of Birth"
            android:focusable="false" />

        <EditText
            android:id="@+id/editGender"
            style="@style/ProfileEditField"
            android:hint="Gender (Optional)" />

        <EditText
            android:id="@+id/editCountry"
            style="@style/ProfileEditField"
            android:hint="Country" />

        <EditText
            android:id="@+id/editBio"
            style="@style/ProfileEditField"
            android:hint="About Me"
            android:gravity="top"
            android:minLines="3"
            android:inputType="textMultiLine" />

        <!-- ACCOUNT SECURITY -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="ACCOUNT SECURITY"
            android:textColor="#FFC107"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/changePassword"
            style="@style/ProfileActionField"
            android:text="🔒   Change Password       ›" />

        <TextView
            android:id="@+id/logoutDevices"
            style="@style/ProfileActionField"
            android:text="📱   Logout from All Devices   ›" />

        <!-- PREFERENCES -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="PREFERENCES"
            android:textColor="#FFC107"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/notificationSettings"
            style="@style/ProfileActionField"
            android:text="🔔   Notifications                 ›" />

        <TextView
            android:id="@+id/languageSettings"
            style="@style/ProfileActionField"
            android:text="🌐   Language                       ›" />

        <TextView
            android:id="@+id/qualitySettings"
            style="@style/ProfileActionField"
            android:text="▶   Video Quality                 ›" />

        <!-- ACCOUNT DETAILS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="ACCOUNT DETAILS"
            android:textColor="#FFC107"
            android:textStyle="bold"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#191920"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/accountCreated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Account Created: 23 Nov 2026"
                android:textColor="#DDDDDD"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/accountStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Account Status: Active"
                android:textColor="#FFC107"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/membershipStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Membership: CineWorld Member"
                android:textColor="#DDDDDD"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- SAVE BUTTON -->
        <Button
            android:id="@+id/saveProfile"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="25dp"
            android:backgroundTint="#FFC107"
            android:text="SAVE CHANGES"
            android:textColor="#101018"
            android:textStyle="bold" />

        <Button
            android:id="@+id/deleteAccount"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#332020"
            android:text="DELETE ACCOUNT"
            android:textColor="#FF5555"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="25dp" />

    </LinearLayout>
</ScrollView>
